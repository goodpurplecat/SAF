# Copie este arquivo pra ".env" (ou configure as mesmas variáveis direto no
# Railway, em Settings > Variables) e preencha com os valores reais.
# NUNCA comite o ".env" de verdade — só este exemplo.
#
# CORREÇÃO (auditoria 12/09/2026): o README já citava este arquivo como
# existente, mas ele nunca tinha sido criado — não havia, em lugar nenhum
# do repo, uma lista central de quais variáveis de ambiente o sistema
# precisa pra rodar. Lista abaixo levantada lendo o que cada módulo
# realmente acessa via os.environ.

# --- IA (Gemini — usado por dp-01, dp-02 e pela Fiscal de Produção do dp-03,
#     apesar de comentários/nomes de método antigos no código mencionarem
#     "Claude" — a integração real é 100% Google Gemini, via google-genai) ---
GEMINI_API_KEY=

# --- Narração (ElevenLabs — opcional: sem isso, o vídeo sai com narração
#     silenciosa/placeholder; ver dp-03/edicao/audio_generator.py) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# --- Banco de dados (Railway cria DATABASE_URL sozinho ao adicionar um
#     serviço PostgreSQL ao projeto) ---
DATABASE_URL=

# --- Autenticação por link mágico / sessão (auth_magic_link.py) ---
SECRET_KEY=

# --- Email transacional (Resend) ---
RESEND_API_KEY=
EMAIL_REMETENTE="Finspots <onboarding@resend.dev>"

# --- Armazenamento de arquivos (Cloudflare R2 — painel R2 > Manage API tokens) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Pagamento (Mercado Pago) ---
MERCADOPAGO_ACCESS_TOKEN=
# Chave do webhook (Mercado Pago > Suas integrações > [app] > Webhooks) —
# DIFERENTE do access token acima.
MERCADOPAGO_WEBHOOK_SECRET=

# --- URLs (sem "/" no final) ---
# Domínio do site estático (finspots.com.br) — pra onde o cliente é
# redirecionado depois de logar, e origem liberada no CORS.
FRONTEND_URL=https://finspots.com.br
# Domínio desta própria API no Railway — usado pra montar o link de login
# mágico (/auth/confirmar) e a notification_url do Mercado Pago.
API_URL=

# --- Vídeo (opcional) ---
# Caminho pra um arquivo de música de fundo (mp3/wav, sem letra) já dentro
# do container/deploy — sem isso, o vídeo sai sem música (ver
# dp-03/edicao/video_assembler.py).
MUSICA_BACKGROUND_PATH=

# --- Playwright (opcional — ver dp-03/edicao/renderer.py) ---
# Só necessário se o binário do Chromium não estiver no caminho padrão do
# Playwright neste ambiente (ex.: build customizado do Railway). Deixe vazio
# pra usar o comportamento padrão do Playwright.
PLAYWRIGHT_CHROMIUM_EXECUTABLE=
